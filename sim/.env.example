# ── MongoDB ───────────────────────────────────
# Local:  MONGO_URI=mongodb://localhost:27017
# Atlas:  MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/?retryWrites=true
MONGO_URI=mongodb://localhost:27017
DB_NAME=deliverybot

# ── JWT ───────────────────────────────────────
# Change to a long random string in production!
JWT_SECRET=deliverybot-change-this-secret-key-32chars!

# ── Gmail SMTP ────────────────────────────────
# 1. Enable 2FA on your Google account
# 2. Go to Google Account → Security → App Passwords
# 3. Generate a 16-char app password (no spaces)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASS=your16charapppassword
